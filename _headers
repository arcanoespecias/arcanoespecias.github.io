# Cache headers para SEO y performance
# HTML: revalidar siempre (puede cambiar)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# CSS y JS: cache agresivo (cambian por versionado ?v=)
/css/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8
/js/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8
/admin/css/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8
/admin/js/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# Imágenes: cache largo
/img/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/productos/*
  Cache-Control: public, max-age=604800

# Sitemap y feeds: cache corto
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/sitemap-images.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/merchant_feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# No indexar admin
/admin/*
  X-Robots-Tag: noindex, nofollow

# Chatbot: API no cacheable, JS/CSS cache 1h (versionable)
/api/*
  Cache-Control: no-store
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type
/css/chatbot.css
  Cache-Control: public, max-age=3600
/js/chatbot.js
  Cache-Control: public, max-age=3600
